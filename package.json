{
  "name": "zeroday-detection",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build:api": "vite build --config vite.api.config.js",
    "start:api": "npm run build:api && node dist-api/server.js",
    "build": "vite build",
    "preview": "vite preview",
    "validate:i18n": "node scripts/validate-i18n.mjs",
    "check:i18n:missing": "node scripts/check-missing-core-translations.mjs",
    "test": "vitest run",
  "lint": "eslint eslint.config.js vite.config.js vite.api.config.js server/index.js src/main.jsx src/pwa.js src/storage/StorageAccess.jsx src/ui/Home.jsx src/ui/LanguageSelector.jsx src/i18n/index.js",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "idb": "8.0.3",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "eslint": "10.11.0",
    "fake-indexeddb": "^6.2.5",
    "typescript": "7.0.2",
    "vite": "8.3.2",
    "vite-plugin-pwa": "1.3.0",
    "vitest": "5.0.3"
  }
}
